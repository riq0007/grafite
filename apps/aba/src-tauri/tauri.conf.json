{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grafite Aba",
  "version": "0.1.0",
  "identifier": "app.grafite.aba",
  "build": {
    "beforeDevCommand": "pnpm dev:tela",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "pnpm build:tela",
    "beforeBundleCommand": "cargo build --release -p grafite-aba-servico",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "aba",
        "create": false,
        "title": "Suporte da TI",
        "width": 440,
        "height": 560,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Grafite",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "wix": {
        "language": "pt-BR",
        "fragmentPaths": ["wix/servico.wxs"],
        "componentGroupRefs": ["ServicoDaAba"]
      }
    }
  }
}
